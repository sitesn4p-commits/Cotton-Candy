PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cotton-candy
CLIENT_URL=http://localhost:5173
# Optional dedicated admin frontend origin.
ADMIN_CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-strong-unique-admin-password
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Cotton Candy Event Deco <hello@yourdomain.com>
EMAIL_REPLY_TO=your-admin-email@example.com
RESEND_BOOKING_TEMPLATE_ID=your_published_resend_template_id
RESEND_COMPLETION_TEMPLATE_ID=your_published_resend_template_id
RESEND_PROMOTION_TEMPLATE_ID=your_published_resend_template_id
# Firebase Admin SDK service account JSON as one line. Required for Android/web push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
