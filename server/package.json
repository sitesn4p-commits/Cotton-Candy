    "seed:starter-gallery": "node --use-system-ca --import tsx src/scripts/seedStarterGallery.ts"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
