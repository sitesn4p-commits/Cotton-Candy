{
  "name": "cotton-candy-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca dist/index.js",
