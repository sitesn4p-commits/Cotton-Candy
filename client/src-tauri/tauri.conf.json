{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cotton Candy Admin",
  "version": "1.0.0",
  "identifier": "au.com.cottoncandyeventdeco.admin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:admin",
    "beforeBuildCommand": "npm run build:admin"
  },
  "app": {
    "windows": [
      {
        "title": "Cotton Candy Admin",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
